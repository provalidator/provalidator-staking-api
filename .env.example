# --- 전부 선택 사항입니다. 아무것도 설정하지 않아도 API 는 동작합니다. ---

# CORS. 비워두면 Access-Control-Allow-Origin: * (공개 데이터라 이게 기본값이자 권장값)
# 설정하면 화이트리스트 모드 + Vary: Origin 이 자동으로 붙습니다.
# ALLOWED_ORIGINS=https://provalidator.com,https://provalidator-x-lplabs.framer.website,https://project-rgx8lciunlx7zqcapsp8.framercanvas.com

# 자체 LCD 노드가 있으면 공개 노드보다 우선 사용됩니다 (REST_<체인ID 대문자>)
# REST_COSMOS=https://cosmos-api.provalidator.com
# REST_OSMOSIS=https://osmosis-api.provalidator.com
# REST_AXELAR=https://axelar-api.provalidator.com
# REST_AGORIC=https://agoric-api.provalidator.com
# REST_ATOMONE=https://atomone-api.provalidator.com

# Upstash Redis 를 Vercel 마켓플레이스에서 연결하면 아래 두 개가 자동 주입됩니다.
# 없으면 KV 폴백만 비활성화되고 나머지는 그대로 동작합니다.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
